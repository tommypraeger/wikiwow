# Copy to .env and fill in what you need. All optional.
PORT=3000

# AI moderator (either or both). Players can also paste a key when creating a game.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Required to use the keys above from the UI. Set this on any public server.
AI_PASSWORD=

# Wikipedia API etiquette: identify yourself in the User-Agent.
WIKI_CONTACT=you@example.com
# WIKI_MIN_INTERVAL_MS=500       # min gap between Wikipedia requests
# WIKI_CACHE_TTL_MS=21600000     # 6h result cache (also persisted to data/)

# Abuse limits (defaults shown)
# AI_CALLS_PER_ROUND=40          # AI requests per round before falling back to built-in judging
# MAX_ROOMS=500
# MAX_CONNECTIONS=1000
# MAX_CONNECTIONS_PER_ROOM=50
# TRUST_PROXY=1                  # behind a reverse proxy: rate-limit by X-Forwarded-For
# HOST=127.0.0.1                 # listen on this machine only (phones won't reach it)
